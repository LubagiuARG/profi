# ── TuProfesional Backend — Variables de entorno ──────────────────────────────
# Copiá este archivo como .env y completá los valores
# NUNCA subas .env a GitHub

# Puerto del servidor
PORT=
# API Key de Anthropic (solo en el backend, nunca en el frontend)
ANTHROPIC_API_KEY=
# Origen permitido del frontend (para CORS)
FRONTEND_URL=
# URL del sitio a scrapear
SCRAPER_URL=
# Postgres (Railway en prod, local en dev)
DATABASE_URL=
# Secreto para firmar JWT — obligatorio en prod (BE-016)
JWT_SECRET=
# MercadoPago — seller token de la cuenta que cobra
MP_ACCESS_TOKEN=
# MercadoPago — secret para verificar firma del webhook (BE-001)
MP_WEBHOOK_SECRET=
# Token para disparar scraping manual via /api/admin (header)
ADMIN_TOKEN=

# ── SMTP (envío de emails reales) ─────────────────────────────────────────────
# Si SMTP_HOST/USER/PASS están seteados, los emails se envían de verdad.
# Si quedan vacíos, los emails se loguean por consola (modo mock).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# En dev: si está seteado, todos los emails se redirigen acá (destinatario real
# va en el subject). En prod: dejar vacía para envíos reales.
EMAIL_REDIRECT_TO=