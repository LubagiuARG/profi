generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profesional {
  id             Int      @id @default(autoincrement())
  nombre         String
  apellido       String
  email          String   @unique
  password       String?
  googleId       String?  @unique
  telefono       String
  matricula      String?
  provincia      String
  zona           String
  descripcion    String?
  especialidades String[]
  plan           String   @default("free")
  verificado     Boolean  @default(false)
  activo         Boolean  @default(true)
  vacaciones     Boolean  @default(false)
  rating         Float    @default(0)
  reviews        Int      @default(0)
  visitas        Int      @default(0)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
  categoriaId    Int?
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  localidad      String?
  localidadId    String?
  radioKm        Int?       @default(20)

  pagos       Pago[]
  resenas     Resena[]
  solicitudes Solicitud[]
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String
  slug        String   @unique
  emoji       String
  descripcion String?
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now())

  profesionales Profesional[]
  solicitudes   Solicitud[]
}

model Cliente {
  id                    Int       @id @default(autoincrement())
  nombre                String
  telefono              String    @unique
  email                 String?
  identidadVerificada   Boolean   @default(false)
  identidadVerificadaEn DateTime?
  creadoEn              DateTime  @default(now())

  solicitudes Solicitud[]
}

model Solicitud {
  id                  Int       @id @default(autoincrement())
  clienteId           Int?
  clienteNombre       String
  clienteTelefono     String
  clienteEmail        String?
  profesionalId       Int
  categoriaId         Int
  presupuestoSnapshot Json
  mensajeExtra        String?
  ubicacion           Json?
  estado              String    @default("pendiente") // pendiente|aceptada|rechazada|expirada|cerrada
  motivoRechazo       String?
  respondidoEn        DateTime?
  cerradoEn           DateTime?
  expiraEn            DateTime
  creadoEn            DateTime  @default(now())

  cliente     Cliente?    @relation(fields: [clienteId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])
  categoria   Categoria   @relation(fields: [categoriaId], references: [id])

  @@index([profesionalId, estado])
  @@index([clienteTelefono])
}

model OtpCliente {
  id           Int       @id @default(autoincrement())
  telefono     String
  codigoHash   String
  intentos     Int       @default(0)
  expiraEn     DateTime
  verificadoEn DateTime?
  creadoEn     DateTime  @default(now())

  @@index([telefono, expiraEn])
}

model Admin {
  id          Int       @id @default(autoincrement())
  nombre      String
  email       String    @unique
  password    String
  rol         String    @default("admin")
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  ultimoLogin DateTime?
}
model Pago {
  id             Int      @id @default(autoincrement())
  profesionalId Int
  monto          Float
  estado         String   @default("pendiente")
  mpPaymentId    String?
  creadoEn       DateTime @default(now())

  profesional Profesional @relation(fields: [profesionalId], references: [id])
}

model Resena {
  id             Int      @id @default(autoincrement())
  profesionalId Int
  autor          String
  rating         Int
  comentario     String?
  creadoEn       DateTime @default(now())

  profesional Profesional @relation(fields: [profesionalId], references: [id])
}